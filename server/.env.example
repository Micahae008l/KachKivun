PORT=3001
MONGODB_URI=mongodb://localhost:27017/kachkivun
JWT_SECRET=your-secret-key-change-in-production
# Use a strong secret in real deploys: openssl rand -base64 32  (≥32 random chars; weak defaults are rejected)
# Access tokens are short-lived; refresh tokens are stored as hashed DB sessions + httpOnly cookie.
# ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=1

# Production: only accept this Host header (blocks direct *.onrender.com / wrong-host probes)
# ALLOWED_HOSTS=api.kachkivun.com

# Rate limits (per IP). Auth routes: request-otp, verify-otp, login, register.
# AUTH_RATE_LIMIT_MAX=5
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=100
# API_RATE_LIMIT_WINDOW_MS=900000
# Promote admin only via: npm run promote-admin -- you@example.com
# (ADMIN_EMAIL is an optional default email for that script — not auto-applied on login)
# ADMIN_EMAIL=admin@your-domain.example
OPENAI_API_KEY=
# Lifetime OpenAI token cap per user (sum of logged usage). Omit = unlimited.
# DEFAULT_USER_TOKEN_CAP=200000
# AI_MATCH_MODEL=gpt-4o
# Any claude-* model routes to Anthropic instead (needs ANTHROPIC_API_KEY), e.g. claude-haiku-5-5.
# ANTHROPIC_API_KEY=
# Match engine: v3 deterministically locks the top five; AI only writes copy.
AI_MATCH_ENGINE=v3
# Rollback switch (defaults to true): true = adaptive assessment then OTP; false = OTP first,
# followed by the lightweight legacy onboarding for incomplete accounts.
PERSONALIZED_FUNNEL_V2=true
# Fail-safe: charging and rank locking are off unless this is explicitly true.
PAYWALL_ENABLED=false
# Required ISO timestamp (with timezone) before enabling the production paywall.
# Accounts created strictly before this cutoff receive permanent grandfathered access.
# PAYWALL_LAUNCH_AT=2026-10-01T09:00:00.000Z
# AI_REPORT_MODEL=gpt-4o  (full report uses a slightly better model)
# AI_REPORT_TEMPERATURE=0.25
# Estimated USD per 1M tokens (for admin cost dashboard)
# AI_PRICE_INPUT_PER_1M=2.5
# AI_PRICE_OUTPUT_PER_1M=10

# Production (subdomain deploy): frontend origin for CORS + link on GET /
# FRONTEND_URL=https://app.your-domain.example
# ALLOWED_ORIGINS=https://app.your-domain.example

# ── Payments ──────────────────────────────────────────────────────────────────
# ai_counselor_top_two is always priced server-side at 1000 agorot (₪10 ILS).
# PAYMENTS_PROVIDER: "mock" (dev/test only), "grow" (Grow API plan) or "grow_link"
# (Grow Payment Links, no API plan). Mock is blocked in production.
PAYMENTS_PROVIDER=mock
# ── grow_link ──
# The fixed ₪10 Payment Link from the Grow dashboard. Configure the page with a
# required email field and a custom text field labelled "קוד הזמנה", and set its
# thank-you redirect to https://<FRONTEND_URL>/payment/return
# GROW_PAYMENT_LINK_URL=https://pay.grow.link/...
# Ask Grow support to enable a webhook for this link pointing at:
#   https://<API_PUBLIC_URL>/api/payments/webhooks/grow/link/<GROW_LINK_WEBHOOK_SECRET>
# GROW_LINK_WEBHOOK_SECRET=   # 32+ random URL-safe chars, e.g. openssl rand -hex 24
# GROW_WEBHOOK_KEY=           # optional: the webhookKey Grow includes, verified when set
# GROW_LINK_METHODS=card,bit  # methods enabled on the Grow page (apple_pay,bit,google_pay,card)
# Public API origin used to build Grow server-to-server callback URLs.
# Required with HTTPS when PAYMENTS_PROVIDER=grow and in production.
# API_PUBLIC_URL=https://api.your-domain.example
# Grow / Meshulam identifiers are environment-specific; never put real values in source control.
# GROW_ENV=sandbox          # sandbox | production (sandbox is blocked in NODE_ENV=production)
# GROW_USER_ID=
# GROW_API_KEY=             # optional for regular merchants; required when Grow issued one
# Method-specific PageCodes issued by Grow. Apple Pay is offered first, then Bit,
# Google Pay, and card. GROW_PAGE_CODE is accepted only as a legacy card fallback.
# GROW_PAGE_CODE_APPLE_PAY=
# GROW_PAGE_CODE_BIT=
# GROW_PAGE_CODE_GOOGLE_PAY=
# GROW_PAGE_CODE_CARD=
# GROW_PAGE_CODE=
# Published merchant/operator details. Do not invent placeholders in production:
# leave charging disabled until the real legal name, phone, address, and contact are supplied.
# BUSINESS_LEGAL_NAME=
# BUSINESS_PHONE=
# BUSINESS_ADDRESS=
# BUSINESS_CONTACT_EMAIL=mishlahat.idf@gmail.com
# CANCELLATION_URL=https://app.your-domain.example/cancellation
# Hard launch acknowledgements. Set true only after the named review is actually complete.
# GROW_CALLBACK_AUTH_CONFIRMED=false
# GROW_DOMAIN_REVIEW_APPROVED=false
# ISRAELI_LEGAL_REVIEW_CONFIRMED=false
# Dedicated callback limiter; separate from API_RATE_LIMIT_MAX so Grow retries are not starved.
# PAYMENT_WEBHOOK_RATE_LIMIT_MAX=600
# PAYMENT_WEBHOOK_RATE_LIMIT_WINDOW_MS=900000

# נתיב אופציונלי לקטלוג תפקידים (JSON). ברירת מחדל: server/data/idf-roles-preference-catalog.json
# IDF_ROLES_CATALOG_PATH=

# ── אימייל OTP ────────────────────────────────────────────────────────────
# Preferred: Resend (better inbox delivery than Gmail SMTP).
#   1. Sign up at https://resend.com → Domains → add kachkivun.com
#   2. Add the SPF / DKIM / (optional) DMARC DNS records Resend shows (Cloudflare DNS)
#   3. Wait until domain status is Verified
#   4. API Keys → Create → paste below
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=קח כיוון <no-reply@kachkivun.com>
#
# Fallback: Gmail SMTP (works, but often lands in spam until Resend is on):
#   1. Google Account → Security → 2FA → App passwords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=קח כיוון <you@gmail.com>
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM=
